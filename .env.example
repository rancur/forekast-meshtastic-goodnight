# --- forekast-meshtastic-goodnight example env ---
# Copy to .env and fill in real values. .env is gitignored.
# All of these can ALSO be set in config.yaml; env vars take precedence.

# ===== Calendar source =====
# A public ICS calendar URL. Forekast.com profiles expose one as
#   https://forekast.com/<your-handle>/calendar.ics
# but any ICS feed works (Google Calendar's "secret address in iCal format",
# self-hosted CalDAV, a static .ics file behind nginx, etc).
CALENDAR_URL=https://forekast.com/yourhandle/calendar.ics

# Calendar-fetch timeout + retry envelope (seconds / attempts)
CALENDAR_TIMEOUT_SECONDS=15
CALENDAR_MAX_ATTEMPTS=3
CALENDAR_RETRY_SLEEP_SECONDS=10

# ===== MeshMonitor target =====
# MeshMonitor exposes POST /api/v1/messages.
# See https://github.com/Yeraze/meshmonitor
MESHMONITOR_URL=http://localhost:8080
MESHMONITOR_API_TOKEN=

# Channel index to broadcast on (0 = primary)
MESHMONITOR_CHANNEL_INDEX=0

# Retry envelope for the MeshMonitor POST
MESHMONITOR_RETRY_MAX_ATTEMPTS=3
MESHMONITOR_RETRY_SLEEP_SECONDS=30
MESHMONITOR_RETRY_TIMEOUT_SECONDS=15

# ===== Message =====
# Single-line greeting + how long each event can be + the overall byte limit
MESSAGE_GREETING=Goodnight mesh! Tomorrow:
MESSAGE_NO_EVENTS_SUFFIX=Nothing scheduled
MESSAGE_REPLY_HINT=DM 'forekast tomorrow' for full list
MESSAGE_MAX_EVENTS=2
MESSAGE_MAX_EVENT_CHARS=150
MESSAGE_MAX_CHARS=200

# ===== Timezone =====
# Tomorrow is resolved in this timezone (Forekast uses local-day semantics).
GOODNIGHT_TZ=America/Phoenix

# ===== Logging =====
FOREKAST_MESH_LOG_LEVEL=INFO
